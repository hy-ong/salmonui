{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["app", "components", "demos", "lib", "tests", "playwright.config.ts"],
  "exclude": ["node_modules", ".next"]
}
