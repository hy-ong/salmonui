{
  "name": "@salmonui/inputs",
  "version": "0.2.0",
  "description": "Form, text, masked and number fields, FileUpload, Checkbox, RadioGroup, Switch, Rating, OtpField, Slider, SignaturePad, ColorPicker, SpeechToText and FormRenderer for Salmon UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hy-ong/salmonui.git",
    "directory": "packages/inputs"
  },
  "homepage": "https://salmonui.dev",
  "bugs": {
    "url": "https://github.com/hy-ong/salmonui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./form": {
      "types": "./dist/form.d.ts",
