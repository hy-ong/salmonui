{
  "name": "@salmonui/data-grid",
  "version": "0.2.0",
  "description": "Virtualized React Data Grid for Salmon UI on a framework-agnostic engine: sorting, filtering, grouping, editing, tree, detail rows, export and server helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hy-ong/salmonui.git",
    "directory": "packages/data-grid"
  },
  "homepage": "https://salmonui.dev",
  "bugs": {
    "url": "https://github.com/hy-ong/salmonui/issues"
  },
  "type": "module",
