{
  "name": "@salmonui/layout",
  "version": "0.2.0",
  "description": "Splitter, Card, Avatar, Timeline, List and DashboardLayout for Salmon UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hy-ong/salmonui.git",
    "directory": "packages/layout"
  },
  "homepage": "https://salmonui.dev",
  "bugs": {
    "url": "https://github.com/hy-ong/salmonui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./splitter": {
      "types": "./dist/splitter.d.ts",
      "import": "./dist/splitter.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./list": {
      "types": "./dist/list.d.ts",
      "import": "./dist/list.js"
    },
    "./dashboard-layout": {
      "types": "./dist/dashboard-layout.d.ts",
      "import": "./dist/dashboard-layout.js"
    },
    "./splitter/styles.css": "./dist/splitter.css",
    "./card/styles.css": "./dist/card.css",
    "./avatar/styles.css": "./dist/avatar.css",
    "./timeline/styles.css": "./dist/timeline.css",
    "./list/styles.css": "./dist/list.css",
    "./dashboard-layout/styles.css": "./dist/dashboard-layout.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@salmonui/core": "0.2.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "engines": {
    "node": ">=22"
  }
}
